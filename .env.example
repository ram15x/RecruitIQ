# copy to .env and fill in. nothing here is a real value.

# required. at least 16 characters, random. generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RECRUITIQ_JWT_SECRET=

# first admin, only used when the user table is empty. remove the password from this file after first start
RECRUITIQ_BOOTSTRAP_USER=admin
RECRUITIQ_BOOTSTRAP_PASSWORD=

# sqlite by default. use a postgres url for anything shared, e.g. postgresql+psycopg://user:pass@host/recruitiq
# RECRUITIQ_DB_URL=sqlite:///./recruitiq.db

# where candidates open the interview link, and where the dashboard finds the API
RECRUITIQ_PUBLIC_URL=http://127.0.0.1:8000
RECRUITIQ_API_URL=http://127.0.0.1:8000

# leave empty to keep the intake webhook switched off
RECRUITIQ_WEBHOOK_SECRET=

# days a candidate's data is kept after their last application
RECRUITIQ_RETENTION_DAYS=180
RECRUITIQ_MAX_UPLOAD_MB=5

# comma separated browser origins allowed to call the API. empty means none
RECRUITIQ_CORS_ORIGINS=

# outgoing mail. leave empty and emails stay drafts that cannot be sent
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# reading applications from a mailbox over IMAP. leave empty to reuse the SMTP login above (same Gmail account).
# Gmail needs 2-step verification, IMAP switched on, and an app password
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASSWORD=
# RECRUITIQ_INBOX_FOLDER=INBOX
# seconds between automatic checks, 60 or more. 0 means only when an admin presses the button
RECRUITIQ_INBOX_POLL_SECONDS=0

# optional language model helpers (job text second opinion, reviewer brief, questions across resumes, interview questions).
# scoring never uses it. resume text is only sent after names and contact details are removed.
# free models may keep prompts, so use a paid model or a no-retention provider for real candidates
OPENROUTER_API_KEY=
# RECRUITIQ_LLM_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku
